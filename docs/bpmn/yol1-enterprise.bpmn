ypoint x="1410" y="225.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="identity_f15_di" bpmnElement="identity_f15"><di:waypoint x="1830" y="1060.0" /><di:waypoint x="1830" y="1060" /><di:waypoint x="1410" y="1060" /><di:waypoint x="1410" y="225.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="identity_f16_di" bpmnElement="identity_f16"><di:waypoint x="1620" y="1060.0" /><di:waypoint x="1620" y="1090" /><di:waypoint x="1410" y="1090" /><di:waypoint x="1410" y="225.0" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="identity_f17_di" bpmnElement="identity_f17"><di:waypoint x="1410" y="145.0" /><di:waypoint x="1410" y="80" /><di:waypoint x="360" y="80" /><di:waypoint x="360" y="145.0" /><bpmndi:BPMNLabel><dc:Bounds x="820.0" y="46.0" width="130" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram><bpmn:process id="kyb" name="05 · Verificación de empresa" isExecutable="false"><bpmn:documentation>Cuatro secciones, borradores, observaciones, rechazo y entidades relacionadas

Secciones: identificación legal; representantes/accionistas/UBO/participaciones; cuatro documentos declarados; actividad, volumen, países, origen de fondos y contrapartes. Se pueden completar en cualquier orden.
Guardar borrador no completa una sección. Guardar sección valida presencia de campos; editar una completa la devuelve a in_progress. Enviar exige 4 completas, cero observaciones y expediente desbloqueado.
in_review, approved y rejected bloquean los formularios. Una observación se elimina con Marcar como corregida: no hay comprobación automática del contenido. El rechazo no tiene apelación implementada.
Agregar entidad pide razón social y país, y crea una entidad related/draft. Cancelar no guarda. No hay expediente independiente implementado para cada entidad relacionada; no bloquea la aprobación global.
